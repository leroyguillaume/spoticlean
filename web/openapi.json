{
  "components": {
    "schemas": {
      "CallbackQuery": {
        "description": "What Spotify appends to the redirect URI. Holds the authorization code:\n never logged.",
        "properties": {
          "code": {
            "description": "The authorization code, when the user accepted.",
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "description": "Why there is no code, e.g. `access_denied`.",
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "description": "Echo of the `state` sent to Spotify.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ConfidenceResponse": {
        "oneOf": [
          {
            "const": "certain",
            "description": "Every track carries the same ISRC.",
            "type": "string"
          },
          {
            "const": "probable",
            "description": "Same title and credits once normalized, same version, close durations.",
            "type": "string"
          },
          {
            "const": "variant",
            "description": "The same song in different recordings: live, remix, new guests, …",
            "type": "string"
          }
        ]
      },
      "CreateRemovalRequest": {
        "example": {
          "trackIds": [
            "0aym2LBJBk9DAYuHHutrIl",
            "3n3Ppam7vgaVa1iaRUc9Lp"
          ]
        },
        "properties": {
          "trackIds": {
            "description": "Spotify IDs of the tracks to remove from the Liked Songs.",
            "items": {
              "type": "string"
            },
            "maxItems": 10000,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "trackIds"
        ],
        "type": "object"
      },
      "FailedRemovalResponse": {
        "properties": {
          "detail": {
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/RemovalFailureReason"
          },
          "trackIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "trackIds",
          "reason",
          "detail"
        ],
        "type": "object"
      },
      "GroupResponse": {
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceResponse"
          },
          "durationGapMs": {
            "description": "Longest track minus shortest track, in milliseconds.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "key": {
            "description": "Opaque and stable across scans as long as the group's tracks keep\n their names, so the UI can remember choices made about the group.",
            "type": "string"
          },
          "tracks": {
            "description": "Sorted by release date, then by the date they were liked.",
            "items": {
              "$ref": "#/components/schemas/TrackResponse"
            },
            "type": "array"
          }
        },
        "required": [
          "key",
          "confidence",
          "durationGapMs",
          "tracks"
        ],
        "type": "object"
      },
      "ProblemResponse": {
        "description": "What every failed request answers, as `application/problem+json`.",
        "example": {
          "detail": "no valid session; log in first",
          "status": 401,
          "title": "Unauthorized",
          "type": "urn:spoticlean:problem:unauthenticated"
        },
        "properties": {
          "detail": {
            "description": "What went wrong, for a human.",
            "type": "string"
          },
          "status": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "description": "The HTTP status phrase.",
            "type": "string"
          },
          "type": {
            "description": "Stable identifier of the kind of problem, `urn:spoticlean:problem:<code>`.",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "type": "object"
      },
      "RemovalFailureReason": {
        "oneOf": [
          {
            "const": "spotifyUnauthorized",
            "description": "Spotify rejected the access token.",
            "type": "string"
          },
          {
            "const": "spotifyForbidden",
            "description": "Spotify refused access, e.g. a scope is missing.",
            "type": "string"
          },
          {
            "const": "spotifyRateLimited",
            "description": "Spotify throttled the requests for longer than the server waits.",
            "type": "string"
          },
          {
            "const": "spotifyUnavailable",
            "description": "Spotify kept failing, or could not be reached.",
            "type": "string"
          },
          {
            "const": "spotifyRejected",
            "description": "Spotify refused this batch.",
            "type": "string"
          },
          {
            "const": "skipped",
            "description": "Not sent, since an earlier batch failed in a way this one would too.",
            "type": "string"
          }
        ]
      },
      "RemovalResponse": {
        "description": "What happened to the requested tracks. Asking twice for the same track\n lists it once.",
        "properties": {
          "failed": {
            "description": "Still liked, in the batches Spotify was sent.",
            "items": {
              "$ref": "#/components/schemas/FailedRemovalResponse"
            },
            "type": "array"
          },
          "removed": {
            "description": "Removed from the Liked Songs, or already absent from them.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "removed",
          "failed"
        ],
        "type": "object"
      },
      "ScanEvent": {
        "description": "One server-sent event of a scan: its `event` field names the variant, its\n `data` field holds the JSON payload. `progress` events come first, then\n exactly one `result` or `error`, then the stream ends.",
        "oneOf": [
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ScanProgressResponse"
              },
              "event": {
                "const": "progress",
                "type": "string"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "type": "object"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ScanResponse"
              },
              "event": {
                "const": "result",
                "type": "string"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "type": "object"
          },
          {
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ProblemResponse"
              },
              "event": {
                "const": "error",
                "type": "string"
              }
            },
            "required": [
              "event",
              "data"
            ],
            "type": "object"
          }
        ]
      },
      "ScanProgressResponse": {
        "description": "How far the scan has got.",
        "example": {
          "fetched": 150,
          "total": 2034
        },
        "properties": {
          "fetched": {
            "description": "Liked Songs read so far.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "total": {
            "description": "Liked Songs in the library.",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "fetched",
          "total"
        ],
        "type": "object"
      },
      "ScanResponse": {
        "description": "The duplicate groups found among the Liked Songs.",
        "properties": {
          "groups": {
            "description": "Most certain first.",
            "items": {
              "$ref": "#/components/schemas/GroupResponse"
            },
            "type": "array"
          },
          "scanned": {
            "description": "Liked Songs read.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "scanned",
          "groups"
        ],
        "type": "object"
      },
      "SessionResponse": {
        "description": "The session as the UI sees it.",
        "example": {
          "scopes": [
            "user-library-read",
            "user-library-modify"
          ]
        },
        "properties": {
          "scopes": {
            "description": "The Spotify scopes the user granted.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "scopes"
        ],
        "type": "object"
      },
      "TrackResponse": {
        "example": {
          "addedAt": "2021-06-02T19:10:03Z",
          "album": "1 (Remastered)",
          "artists": [
            "The Beatles"
          ],
          "durationMs": 425653,
          "id": "0aym2LBJBk9DAYuHHutrIl",
          "isrc": "GBUM71505078",
          "releaseDate": "2000-11-13",
          "title": "Hey Jude - Remastered 2015",
          "versionLabel": "Remastered 2015"
        },
        "properties": {
          "addedAt": {
            "description": "When the track was liked, RFC 3339.",
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "artists": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "durationMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "description": "Spotify track ID.",
            "type": "string"
          },
          "isrc": {
            "type": [
              "string",
              "null"
            ]
          },
          "releaseDate": {
            "description": "Album release date as Spotify gives it: `YYYY`, `YYYY-MM` or `YYYY-MM-DD`.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "versionLabel": {
            "description": "The title's version or reissue suffixes as written (`2012 Remaster`,\n `Live`), `null` for a bare title.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "artists",
          "album",
          "durationMs",
          "addedAt"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "description": "Set by `/auth/callback`, encrypted, HttpOnly",
        "in": "cookie",
        "name": "spoticlean_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Finds duplicates among the Spotify Liked Songs, and removes them.",
    "title": "spoticlean",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/removals": {
      "post": {
        "description": "Sends the tracks to Spotify in batches of 40, its limit, one batch after the other. Answers 200 when every track is removed, 207 when only some are (the others are listed with the reason), and the status of the first failure, as a problem, when none is.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRemovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovalResponse"
                }
              }
            },
            "description": "Every track is removed"
          },
          "207": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovalResponse"
                }
              }
            },
            "description": "Some tracks are removed, the others are listed in `failed`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "No session, or Spotify rejected its token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "No track, too many, or a malformed track ID"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "Spotify failed every batch"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "Remove tracks from the Liked Songs",
        "tags": [
          "Library"
        ]
      }
    },
    "/api/v1/scan": {
      "get": {
        "description": "Reads the whole library and answers with a `text/event-stream`: a `progress` event per page read, then one `result` event holding the duplicate groups, or one `error` event holding a problem, and the stream ends. Nothing is stored: each request scans anew, and closing the stream cancels the scan. A missing session is a 401 before the stream starts.",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ScanEvent"
                }
              }
            },
            "description": "Server-sent events: `progress`, then `result` or `error`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "No session, or one that cannot be renewed"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "Scan the Liked Songs for duplicates",
        "tags": [
          "Library"
        ]
      }
    },
    "/api/v1/session": {
      "delete": {
        "description": "Clears the session cookie. Answers 204 whether or not there was one.",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        },
        "summary": "Log out",
        "tags": [
          "Authentication"
        ]
      },
      "get": {
        "description": "Answers 200 while the user is logged in, renewing the Spotify access token when it is about to expire, and 401 otherwise.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "The session as the UI sees it."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "No session, or one that cannot be renewed"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "Read the current session",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "description": "Spotify's redirect target. Checks `state` against the login cookie, exchanges the code, sets the session cookie, and redirects to `/`. On failure, redirects to `/?authError=<code>`, `<code>` being `invalidState`, `accessDenied`, `loginFailed` or `spotifyUnavailable`.",
        "parameters": [
          {
            "description": "The authorization code, when the user accepted.",
            "in": "query",
            "name": "code",
            "schema": {
              "description": "The authorization code, when the user accepted.",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "description": "Why there is no code, e.g. `access_denied`.",
            "in": "query",
            "name": "error",
            "schema": {
              "description": "Why there is no code, e.g. `access_denied`.",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "description": "Echo of the `state` sent to Spotify.",
            "in": "query",
            "name": "state",
            "schema": {
              "description": "Echo of the `state` sent to Spotify.",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the UI"
          }
        },
        "summary": "Complete the Spotify login",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/login": {
      "get": {
        "description": "A page the browser navigates to, not an API call: redirects to the Spotify consent page, which sends the user back to `/auth/callback`.",
        "responses": {
          "303": {
            "description": "Redirect to the Spotify consent page"
          }
        },
        "summary": "Log in with Spotify",
        "tags": [
          "Authentication"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Spotify login and the session cookie",
      "name": "Authentication"
    },
    {
      "description": "Duplicate detection and removal in the Liked Songs",
      "name": "Library"
    }
  ]
}
